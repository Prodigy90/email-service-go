# Environment
ENV=development
API_PORT=8083
LOG_LEVEL=info                 # debug, info, warn, error

# Database (PostgreSQL)
DATABASE_URL=postgres://email:email@localhost:55433/email_service?sslmode=disable
POSTGRES_USER=email
POSTGRES_PASSWORD=email
POSTGRES_DB=email_service
POSTGRES_PORT=55433

# Redis
REDIS_URL=redis://localhost:16380/0

# SMTP Configuration (AWS SES example)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=your-ses-smtp-username
SMTP_PASSWORD=your-ses-smtp-password
SMTP_FROM_ADDRESS=noreply@yourdomain.com
SMTP_FROM_NAME=Your App Name

# Default Reply-To address (applied to all emails unless overridden per-email)
REPLY_TO_ADDRESS=hello@yourdomain.com

# For local development with Mailhog
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_ADDRESS=test@localhost
# SMTP_FROM_NAME=Test App

# API Authentication (services authenticate with this key)
API_KEY=your-secure-api-key-here

# Template directory
TEMPLATE_DIR=./pkg/templates

# Migrations directory (default: ./migrations for local, /app/migrations in Docker)
MIGRATIONS_DIR=./migrations

# Swagger UI Configuration
# Comma-separated list of IPs or CIDR ranges allowed to access /swagger
# Leave empty for open access (dev mode)
# Example: "100.64.0.0/10" for Tailscale network only
SWAGGER_ALLOWED_IPS=
